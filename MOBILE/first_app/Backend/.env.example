# MongoDB Credentials
MONGO_USERNAME=chatadmin
MONGO_PASSWORD=chatpass123

# Database URL: used when running Prisma / Nest locally outside of docker
DATABASE_URL="mongodb://chatadmin:chatpass123@localhost:27017/chatapp?authSource=admin&replicaSet=rs0&directConnection=true"

# Server configuration
PORT=3000
HOST=0.0.0.0
BOT_MODE=false             # set to true to enable FactBot simulation
MONGO_SILENT_LOGS=true    # set to false to show verbose MongoDB logs in docker output

# Largest image/file upload in MB (max 15 — MongoDB documents are limited to 16 MB)
MAX_UPLOAD_MB=10

# Longest an "upload from URL" download may take, in milliseconds
REMOTE_FETCH_TIMEOUT_MS=15000
